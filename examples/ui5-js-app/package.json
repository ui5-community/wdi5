{
  "name": "ui5-app",
  "version": "0.8.15-notimportant",
  "private": true,
  "description": "sample ui5 app for testing wdi5",
  "license": "UNLICENSED",
  "author": "j&s-soft GmbH",
  "main": "webapp/index.html",
  "scripts": {
    "start": "ui5 serve -p 8081",
    "test": "run-s test:**",
    "test:lateInject": "wait-on tcp:8081 -t 15s && wdio run webapp/test/wdio-ui5-late.conf.cjs --headless",
    "test:ui5tooling": "wait-on tcp:8081 -t 15s && wdio run webapp/test/wdio-ui5tooling.conf.cjs --headless",
    "test:multiremote": "wait-on tcp:8081 -t 15s && wdio run webapp/test/wdio-multiremote.conf.cjs --headless",
    "test:urlDeprecation": "wait-on tcp:8081 -t 15s && wdio run webapp/test/wdi5-urlDeprecation.conf.cjs --headless",
    "test:classic": "wait-on tcp:8081 -t 15s && wdio run webapp/test/wdio-classic.conf.cjs --headless",
    "test:webserver": "wait-on tcp:8081 -t 15s && wdio run webapp/test/wdio-webserver.conf.cjs --headless",
    "start:test": "run-p -r start test"
  },
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2",
    "ui5-middleware-simpleproxy": "^3",
    "wdio-ui5-service": "*"
  },
  "peerDependencies": {
    "@wdio/sauce-service": "^9"
  }
}
